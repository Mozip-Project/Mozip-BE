# 단체, 팀, 운영진, 초대, 대표자 인수

enum OrganizationType {
    CLUB
    ACADEMIC
    STUDENT_COUNCIL
}

"학생회 세부 구분 (총학생회 / 단과대 / 학과)"
enum CouncilLevel {
    UNIVERSITY
    COLLEGE
    DEPARTMENT
}

"교내 / 연합 (연합이면 학교 없음)"
enum OrganizationScope {
    CAMPUS
    UNION
}

"관리자 심사 상태 (단체 등록, 학교 인증)"
enum ReviewStatus {
    PENDING
    APPROVED
    REJECTED
}

enum OrganizationField {
    ACADEMIC_STUDY
    IT_DEV
    DESIGN_MEDIA
    PERFORMANCE_MUSIC
    SPORTS
    CULTURE_HOBBY
    VOLUNTEER
    LANGUAGE_GLOBAL
    STARTUP_BUSINESS
    RELIGION
    ETC
}

enum OrganizationLinkType {
    INSTAGRAM
    WEBSITE
    YOUTUBE
    ETC
}

enum MemberRole {
    REPRESENTATIVE
    OPERATOR
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    CANCELED
}

enum TransferStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELED
}

type Organization {
    id: ID!
    name: String!
    "변경 요청 이름 (관리자 확인 후 반영)"
    pendingName: String
    type: OrganizationType!
    "학생회가 아니면 null"
    councilLevel: CouncilLevel
    scope: OrganizationScope!
    "연합이면 null"
    school: School
    logoUrl: String
    "한 줄 소개"
    tagline: String
    description: String
    "단체 메일"
    email: String
    noTeam: Boolean!
    "심사 증빙. 소속 운영진에게만 보이고 그 외에는 null"
    proofLink: String
    "심사 증빙. 소속 운영진에게만 보이고 그 외에는 null"
    proofFileUrl: String
    reviewStatus: ReviewStatus!
    rejectReason: String
    trialEndsAt: DateTime
    "유료 기능 사용 가능 기한"
    packageEndsAt: DateTime
    "UP하기 잔여권"
    upCredits: Int!
    keywords: [String!]!
    fields: [OrganizationField!]!
    links: [OrganizationLink!]!
    teams: [Team!]!
    "소속 운영진만 조회 가능. 그 외에는 COMMON_403"
    members: [Member!]!
    createdAt: DateTime!
}

type OrganizationLink {
    id: ID!
    type: OrganizationLinkType!
    url: String!
}

type Team {
    id: ID!
    organization: Organization!
    name: String!
    sortOrder: Int!
}

"단체 운영진 (회원의 단체 소속)"
type Member {
    id: ID!
    organization: Organization!
    user: User!
    "한 팀에만 소속, 팀 없는 단체면 null"
    team: Team
    role: MemberRole!
    createdAt: DateTime!
}

type Invitation {
    id: ID!
    organization: Organization!
    inviter: User!
    "가입자면 바로 채움, 미가입이면 수락 시 로그인 회원과 연락처를 비교해 채움"
    invitee: User
    "휴대폰 번호(숫자만) 또는 이메일(소문자)"
    inviteeContact: String!
    "합류 시 배정할 팀, null = 팀 미지정"
    team: Team
    "초대 수락 코드 (acceptInvitation의 code). 초대받은 사람 알림 링크에 실림"
    code: String!
    status: InvitationStatus!
    "발송 후 7일"
    expiresAt: DateTime!
    createdAt: DateTime!
}

"초대 링크 (mo-zip.com/invite/{token})"
type InviteLink {
    id: ID!
    organization: Organization!
    "acceptInvitation의 code로 씀"
    token: String!
    "공유할 링크 주소"
    url: String!
    "생성 후 7일"
    expiresAt: DateTime!
}

type RepresentativeTransfer {
    id: ID!
    organization: Organization!
    requester: User!
    message: String
    status: TransferStatus!
    createdAt: DateTime!
}

input CreateOrganizationInput {
    name: String!
    type: OrganizationType!
    "학생회면 필수, 그 외 단체는 넣으면 COMMON_400 (reason COUNCIL_LEVEL_NOT_ALLOWED)"
    councilLevel: CouncilLevel
    scope: OrganizationScope!
    "교내면 필수, 연합이면 넣으면 COMMON_400 (reason SCHOOL_NOT_ALLOWED)"
    schoolId: ID
    noTeam: Boolean! = false
    proofLink: String
    proofFileUrl: String
}

"단체 프로필 수정 입력. 단체명은 바꿀 수 없음 (관리자 문의). 키워드/분야/링크는 보낸 목록으로 전체 교체"
input UpdateOrganizationInput {
    "업로드 URL 발급으로 받은 fileUrl, null이나 빈 문자열이면 기본 이미지로 초기화. http/https 주소만 받음"
    logoUrl: String
    "한 줄 소개, 최대 40자"
    tagline: String!
    description: String
    "단체 메일, 빈 문자열은 null로 저장"
    email: String
    "학생회가 아니면 1개 이상 (reason FIELDS_REQUIRED), 학생회는 빈 목록 (reason FIELDS_NOT_ALLOWED)"
    fields: [OrganizationField!]!
    "검색 키워드 1~10개, 중복은 하나로 합침"
    keywords: [String!]!
    "SNS/웹사이트 주소 1~10개. 스킴이 없으면 https://를 붙이고 type은 호스트로 추정. 호스트가 없거나 http/https가 아니거나 https://를 붙여 500자를 넘으면 reason LINK_URL_INVALID"
    links: [String!]!
}

"팀 목록 저장 한 줄. id가 있으면 그 팀 수정, 없으면 새 팀"
input TeamInput {
    id: ID
    "앞뒤 공백 제거 후 1~50자, 한 요청 안에서 중복 불가"
    name: String!
}

extend type Query {
    "단체 상세, 로그인 없이 조회 가능. 없거나 심사 승인 전인데 소속 운영진이 아니면 ORG_404"
    organization(id: ID!): Organization! @public
    "키워드 자동완성, 심사 승인된 단체 키워드 중 접두 일치 상위 10개 (많이 쓰인 순). 빈 접두어거나 20자를 넘으면 빈 목록"
    keywordSuggestions(prefix: String!): [String!]!
    "운영진 관리 표. 그 단체 운영진만 조회 가능 (아니면 COMMON_403), 없으면 ORG_404. 내보내진 운영진은 빼고 대표자 먼저, 그 뒤 합류일 오름차순"
    members(organizationId: ID!): [Member!]!
}

extend type Mutation {
    "단체를 만들고 호출자를 대표자로 등록, 심사 상태는 PENDING"
    createOrganization(input: CreateOrganizationInput!): Organization!
    "단체 프로필 수정, 그 단체의 운영진만 가능 (아니면 COMMON_403). 없으면 ORG_404"
    updateOrganization(id: ID!, input: UpdateOrganizationInput!): Organization!
    "운영진 내보내기, 대표자만 가능 (아니면 COMMON_403). 대표자 행은 못 내보냄 (MEMBER_409, reason REPRESENTATIVE), 없거나 이미 나간 운영진이면 MEMBER_404. 행은 남기고 leftAt을 찍으며 남은 소속이 없으면 그 회원의 lastRole을 APPLICANT로 돌림"
    removeMember(memberId: ID!): Boolean!
    "운영진 개인 초대, 그 단체 운영진만 (아니면 COMMON_403). contact는 휴대폰 번호(하이픈 허용) 또는 이메일, 형식이 틀리면 COMMON_400 (reason CONTACT_INVALID). 가입자면 invitee를 채우고 INVITATION 알림. 7일 뒤 만료. 이미 운영진이면 MEMBER_409 (reason ALREADY_MEMBER), 대기 중 초대가 있으면 MEMBER_409 (reason ALREADY_INVITED). teamId는 그 단체 팀만 (reason TEAM_NOT_FOUND), 팀 없는 단체면 reason NO_TEAM_ORGANIZATION"
    inviteMember(organizationId: ID!, contact: String!, teamId: ID): Invitation!
    "공용 초대 링크 발급, 그 단체 운영진만. 유효한 링크가 있으면 그 링크를 돌려주고 없으면 7일짜리 새 링크"
    createInviteLink(organizationId: ID!): InviteLink!
    "개인 초대 코드 또는 공용 링크 토큰으로 합류해 OPERATOR가 됨. 없는 코드 MEMBER_404, 만료 MEMBER_410, 처리된 초대 MEMBER_409 (reason ALREADY_HANDLED), 이미 운영진 MEMBER_409 (reason ALREADY_MEMBER). 개인 초대는 초대받은 회원(휴대폰 일치)만 수락 가능 (아니면 COMMON_403). 합류하면 그 단체에서 같은 회원에게 걸려 있던 다른 대기 초대는 CANCELED가 됨"
    acceptInvitation(code: String!): Member!
    "팀 목록 전체 교체, 그 단체 운영진만. 배열 순서가 sortOrder. 목록에서 빠진 팀은 삭제하고 소속 운영진은 팀 미지정으로. 팀 없는 단체면 COMMON_400 (reason NO_TEAM_ORGANIZATION), 공고 포지션이 쓰는 팀을 빼면 TEAM_409. 이름 규칙 위반 reason TEAM_NAME_INVALID / TEAM_DUPLICATED, 다른 단체 팀 id는 TEAM_NOT_FOUND"
    saveTeams(organizationId: ID!, teams: [TeamInput!]!): [Team!]!
}
