# 공고, 포지션, 지원서 문항, 면접 질문, 면접 가능 시간, 스크랩, 신고

"비면접 공고는 INTERVIEW 단계를 건너뜀"
enum PostingStatus {
    DRAFT
    RECRUITING
    DOC_REVIEW
    DOC_RESULT_NOTICE
    INTERVIEW
    FINAL_RESULT
    ENDED
}

enum InterviewMethod {
    ONSITE
    ONLINE
}

"면접관 자동 배정 기준 (포지션 없는 모집은 자동 배정 없이 직접 추가)"
enum AssignRule {
    "지원 포지션과 같은 팀 운영진"
    SAME_TEAM
    "팀 상관없이 운영진 전체"
    ALL_MEMBERS
}

enum QuestionType {
    TEXT
    SINGLE_CHOICE
    MULTI_CHOICE
    FILE_LINK
    TABLE
}

enum ReportReason {
    FALSE_INFO
    INAPPROPRIATE
    EXCESSIVE_PERSONAL_INFO
    ETC
}

"모집 공고"
type Posting {
    id: ID!
    organization: Organization!
    "이전 기수 불러오기로 만든 공고의 원본"
    sourcePosting: Posting
    title: String!
    "모집 학기 (예: 2026-2)"
    semester: String
    "모집 안내 (HTML)"
    content: String
    status: PostingStatus!
    "작성 중 단계 1~5"
    draftStep: Int
    hasInterview: Boolean!
    "비면접이면 null"
    interviewMethod: InterviewMethod
    noPosition: Boolean!
    "null = 비공개"
    region: String
    "null = 비공개"
    fee: String
    "지원 자격: 대학생"
    allowEnrolled: Boolean!
    "지원 자격: 휴학생"
    allowOnLeave: Boolean!
    "지원 자격 직접 입력 (예: 1~3학년, 졸업 예정자 가능)"
    eligibilityNote: String
    "활동 기간 시작 월 (1일)"
    activityStartedOn: Date
    "활동 기간 종료 월 (1일)"
    activityEndedOn: Date
    "게시 예정 시각, 이 시각이 되면 DRAFT에서 RECRUITING으로 전환, null = 게시하기 누를 때 바로 게시"
    publishAt: DateTime
    "실제 게시된 시각"
    publishedAt: DateTime
    "지원 접수 시작, 게시 후 이 시각 전까지는 공고만 보이고 지원 불가"
    recruitStartAt: DateTime
    recruitEndAt: DateTime
    "서류 결과 / 면접 일정 안내일"
    docResultAt: DateTime
    finalResultAt: DateTime
    "서류 평가 결과 확정 시각, null = 확정 전"
    docResultConfirmedAt: DateTime
    "면접 평가 결과 확정 시각, null = 확정 전"
    finalResultConfirmedAt: DateTime
    interviewMinutes: Int
    breakMinutes: Int
    assignRule: AssignRule
    maxApplicantsPerInterview: Int
    maxParallelInterviews: Int
    "서류 평가에 문항별 점수(1~5점) 사용"
    docScorePerQuestion: Boolean
    "면접 평가에 질문별 점수 사용"
    interviewScorePerQuestion: Boolean
    "지원자에게 보여줄 면접 안내 (준비물 등)"
    interviewGuide: String
    "타임테이블 확정 시각"
    timetableConfirmedAt: DateTime
    viewCount: Int!
    "최신순 정렬 기준 (게시, UP 시 갱신)"
    bumpedAt: DateTime
    images: [PostingImage!]!
    positions: [Position!]!
    questions: [Question!]!
    interviewQuestions: [InterviewQuestion!]!
    interviewTimeRanges: [InterviewTimeRange!]!
    createdAt: DateTime!
    updatedAt: DateTime!
}

type PostingImage {
    id: ID!
    url: String!
    "대표 이미지 (전체 공고 카드 썸네일), 안 고르면 첫 번째 사진"
    isRepresentative: Boolean!
    sortOrder: Int!
}

"공고별 모집 포지션"
type Position {
    id: ID!
    posting: Posting!
    team: Team
    name: String!
    "null = 모집 인원 미정"
    headcount: Int
    sortOrder: Int!
}

"지원서 문항"
type Question {
    id: ID!
    posting: Posting!
    "적용 포지션, null = 공통 문항"
    position: Position
    type: QuestionType!
    title: String!
    description: String
    required: Boolean!
    "TEXT 글자 수 제한"
    maxLength: Int
    options: QuestionOptions
    sortOrder: Int!
}

"문항 유형별 설정 (해당 유형 값만 채움)"
type QuestionOptions {
    "SINGLE_CHOICE / MULTI_CHOICE 보기"
    choices: [String!]
    "TABLE 열 이름"
    columns: [String!]
    "TABLE 최대 행"
    maxRows: Int
    "FILE_LINK 최대 개수"
    maxFiles: Int
}

"면접 질문"
type InterviewQuestion {
    id: ID!
    posting: Posting!
    "null = 공통 질문"
    position: Position
    content: String!
    sortOrder: Int!
}

"운영진이 연 면접 가능 시간대"
type InterviewTimeRange {
    id: ID!
    posting: Posting!
    "이 시간을 쓰는 포지션(팀), null = 포지션 없는 모집 또는 전체 공통"
    position: Position
    date: Date!
    startTime: LocalTime!
    endTime: LocalTime!
    "운영진이 끈 블록의 시작 시각, 지원자에게 안 보임"
    closedSlots: [LocalTime!]!
}

type Scrap {
    id: ID!
    user: User!
    posting: Posting!
    createdAt: DateTime!
}

"공고 신고"
type Report {
    id: ID!
    posting: Posting!
    user: User!
    reason: ReportReason!
    detail: String
    createdAt: DateTime!
}

"목록 정렬 기준"
enum PostingSort {
    "bumpedAt 최신순 (기본)"
    LATEST
    "모집 마감 임박순"
    CLOSING_SOON
    "조회수 많은 순"
    POPULAR
}

"모집 중 공고 목록 필터"
input PostingFilter {
    keyword: String
    schoolId: ID
    organizationType: OrganizationType
    "TODO: 기준 데이터가 아직 없어 받기만 하고 적용하지 않음"
    fields: [String!]
    hasInterview: Boolean
    "마감 3일 이내"
    closingSoon: Boolean
}

type PostingPage {
    items: [Posting!]!
    totalCount: Int!
    hasNext: Boolean!
}

input PostingImageInput {
    url: String!
    sortOrder: Int!
}

input PositionInput {
    teamId: ID
    name: String!
    "null = 모집 인원 미정"
    headcount: Int
    sortOrder: Int!
}

"해당 유형 값만 채움"
input QuestionOptionsInput {
    choices: [String!]
    columns: [String!]
    maxRows: Int
    maxFiles: Int
}

input QuestionInput {
    "null = 공통 문항. 2단계에서 먼저 저장된 Position의 id"
    positionId: ID
    type: QuestionType!
    title: String!
    description: String
    required: Boolean!
    maxLength: Int
    options: QuestionOptionsInput
    sortOrder: Int!
}

input InterviewTimeRangeInput {
    "null = 포지션 없는 모집 또는 전체 공통. 2단계에서 먼저 저장된 Position의 id"
    positionId: ID
    date: Date!
    startTime: LocalTime!
    endTime: LocalTime!
    closedSlots: [LocalTime!]
}

"5단계 입력을 한 타입에 모아두고, 단계별로 그 단계에 해당하는 필드만 채워서 보냄 (나머지는 null = 기존 값 유지)"
input PostingDraftInput {
    "1단계 basic"
    title: String
    content: String
    semester: String
    region: String
    fee: String
    allowEnrolled: Boolean
    allowOnLeave: Boolean
    eligibilityNote: String
    activityStartedOn: Date
    activityEndedOn: Date
    recruitStartAt: DateTime
    recruitEndAt: DateTime
    "최대 5장"
    images: [PostingImageInput!]

    "2단계 positions"
    noPosition: Boolean
    positions: [PositionInput!]

    "3단계 interview"
    hasInterview: Boolean
    interviewMethod: InterviewMethod
    interviewMinutes: Int
    breakMinutes: Int
    assignRule: AssignRule
    maxApplicantsPerInterview: Int
    maxParallelInterviews: Int
    interviewTimeRanges: [InterviewTimeRangeInput!]

    "4단계 questions"
    docScorePerQuestion: Boolean
    questions: [QuestionInput!]

    "5단계 exposure"
    publishAt: DateTime
    representativeImageId: ID
}

extend type Query {
    "공고 상세. DRAFT는 그 단체 운영진만 조회 가능 (아니면 POSTING_404로 숨김)"
    posting(id: ID!): Posting! @public
    "모집 중(RECRUITING) 공고 카드 목록"
    postings(filter: PostingFilter, sort: PostingSort = LATEST, page: Int = 0, size: Int = 20): PostingPage! @public
    "운영진 홈의 단체 공고 목록 (draftStep 포함). COMMON_403이면 그 단체 운영진이 아님"
    organizationPostings(organizationId: ID!, status: [PostingStatus!]): [Posting!]!
}

extend type Mutation {
    """
    공고 작성/수정. id가 없으면 새 DRAFT를 만들고, 있으면 그 공고를 이어서 수정함.
    input은 보내는 단계의 필드만 채우면 되고 나머지는 null로 두면 기존 값이 유지됨.
    DRAFT가 아닌 공고를 수정하면 POSTING_409(reason: NOT_DRAFT)
    """
    savePostingDraft(organizationId: ID!, id: ID, input: PostingDraftInput!): Posting!
    """
    공고 게시. publishAt이 없으면 즉시 RECRUITING으로 전환하고, 있으면 DRAFT로 두고 스케줄러에 맡김.
    필수 단계가 비어 있으면 POSTING_400(fieldErrors에 단계 표시), 이미 게시됨이면 POSTING_409(reason: ALREADY_PUBLISHED),
    단체 이용권이 없으면 ORG_402
    """
    publishPosting(id: ID!): Posting!
    """
    공고 진행 단계를 정해진 순서로만 한 단계 전환.
    RECRUITING -> DOC_REVIEW -> DOC_RESULT_NOTICE -> (비면접은 건너뜀) INTERVIEW -> FINAL_RESULT -> ENDED.
    순서가 아니거나 DRAFT/ENDED에서 호출하면 POSTING_409(reason: INVALID_STATUS_TRANSITION),
    서류 결과 미확정이면 POSTING_409(reason: DOC_RESULT_NOT_CONFIRMED),
    최종 결과 미확정이면 POSTING_409(reason: FINAL_RESULT_NOT_CONFIRMED)
    """
    advancePostingStatus(id: ID!, to: PostingStatus!): Posting!
}
