# 지원서, 답변, 첨부

enum ApplicationStatus {
    DRAFT
    SUBMITTED
}

enum DocResult {
    "평가가 다 끝나지 않아 선택 불가"
    PENDING
    "보류 (남아 있으면 결과 확정 불가)"
    HOLD
    PASS
    FAIL
}

enum FinalResult {
    PENDING
    PASS
    FAIL
}

enum AttachmentType {
    FILE
    LINK
}

"지원서"
type Application {
    id: ID!
    posting: Posting!
    "포지션 없는 모집이면 null"
    position: Position
    user: User!
    status: ApplicationStatus!
    "제출 시점 프로필"
    profileSnapshot: JSON
    "면접 가능 시간 블록의 시작 시각 목록"
    availableTimes: [DateTime!]!
    docResult: DocResult!
    finalResult: FinalResult!
    submittedAt: DateTime
    answers: [Answer!]!
    createdAt: DateTime!
    updatedAt: DateTime!
}

"지원서 문항별 답변"
type Answer {
    id: ID!
    question: Question!
    "TEXT 답변, CHOICE / TABLE은 JSON 문자열"
    content: String
    attachments: [Attachment!]!
}

"FILE_LINK 문항 첨부"
type Attachment {
    id: ID!
    type: AttachmentType!
    url: String!
    fileName: String
}

input AttachmentInput {
    type: AttachmentType!
    "FILE = presigned URL(purpose=APPLICATION_ATTACHMENT)로 올린 파일의 키/URL, LINK = 지원자가 입력한 링크"
    url: String!
    fileName: String
}

input AnswerInput {
    questionId: ID!
    "TEXT 답변, CHOICE / TABLE은 JSON 문자열"
    content: String
    "FILE_LINK 문항만"
    attachments: [AttachmentInput!]
}

input ApplicationInput {
    "null = 포지션 없는 모집"
    positionId: ID
    answers: [AnswerInput!]
    "면접 가능 시간 블록의 시작 시각 목록. 면접 없는 공고면 무시"
    availableTimes: [DateTime!]
}

extend type Query {
    "지원서 상세. 지원자 본인 또는 그 공고 단체 운영진만 조회 가능. 없으면 APPLICATION_404"
    application(id: ID!): Application!
    "내 작성 중·제출 지원서 목록"
    myApplications(status: ApplicationStatus): [Application!]!
}

extend type Mutation {
    """
    지원서 임시 저장. 없으면 DRAFT를 만들고, 있으면 포지션과 답변을 덮어씀.
    모집 기간이 아니면 POSTING_409(reason: NOT_RECRUITING), 이미 제출했으면 APPLICATION_409(reason: ALREADY_SUBMITTED)
    """
    saveApplicationDraft(postingId: ID!, input: ApplicationInput!): Application!
    """
    지원서 제출. 이후 수정·철회 불가.
    필수 문항 누락·글자 수·선택지·첨부 개수 위반이면 APPLICATION_400(fieldErrors에 questionId별 메시지),
    지원 자격(학교 인증) 미충족이면 USER_403,
    모집 마감이면 POSTING_409(reason: NOT_RECRUITING), 이미 제출했으면 APPLICATION_409(reason: ALREADY_SUBMITTED)
    """
    submitApplication(id: ID!): Application!
}
