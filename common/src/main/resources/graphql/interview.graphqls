# 면접 타임테이블

"타임테이블의 면접 한 칸"
type Interview {
    id: ID!
    posting: Posting!
    startAt: DateTime!
    endAt: DateTime!
    "같은 시간대에 동시에 진행하는 면접실 열 (면접실 1, 면접실 2), 1부터"
    track: Int!
    "면접 장소, 운영진이 직접 입력 (후보 = InterviewTimetable.recentLocations)"
    location: String
    "운영진이 직접 추가한 면접관, 자동 배정은 없어 처음에는 비어 있음"
    interviewers: [Member!]!
    "배정된 지원자, 2명 이상이면 그룹 면접. 자동 생성은 같은 포지션끼리만 묶고 직접 배정은 포지션 제한 없음"
    applicants: [Application!]!
}

"타임테이블 격자의 블록 한 칸. 면접 설정과 운영진이 연 시간대로 매번 계산하고 저장하지 않음"
type InterviewSlot {
    startAt: DateTime!
    "면접이 끝나는 시각, 쉬는 시간은 그 뒤에 붙음"
    endAt: DateTime!
    "운영진이 끈 블록이면 true, 자동 생성은 여기에 배정하지 않음"
    closed: Boolean!
}

"운영진이 보는 면접 타임테이블"
type InterviewTimetable {
    posting: Posting!
    "확정 시각, 확정 전이면 null"
    confirmedAt: DateTime
    "빈 칸까지 포함한 전체 블록, 시간순. 면접 설정이 덜 채워졌으면 빈 목록"
    slots: [InterviewSlot!]!
    "만들어진 면접 칸, 시작 시각과 track 순. 운영진이 직접 추가한 칸은 지원자가 없을 수 있음"
    interviews: [Interview!]!
    "서류 합격인데 어느 칸에도 없는 지원자, 먼저 낸 순"
    unassignedApplicants: [Application!]!
    "이 모집에서 쓴 장소, 최근에 쓴 순"
    recentLocations: [String!]!
}

"면접 칸 추가와 수정. null인 필드는 그대로 둠"
input InterviewInput {
    "없으면 startAt 블록에 칸을 새로 추가, 있으면 그 칸을 수정"
    id: ID
    "새 칸의 시작 시각, 열려 있는 블록의 시작 시각이어야 함. id가 있으면 무시"
    startAt: DateTime
    "면접 장소, 100자까지. 빈 문자열이면 비움"
    location: String
    "이 칸의 지원자 전체. 다른 칸에 있던 지원자는 옮겨 오고 목록에서 빠진 지원자는 미배정이 됨. 2명 이상이면 그룹 면접"
    applicationIds: [ID!]
    "이 칸의 면접관(Member id) 전체"
    interviewerMemberIds: [ID!]
}

extend type Query {
    "면접 타임테이블 조회. 그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404. 생성 전이면 interviews는 비고 서류 합격자가 전부 unassignedApplicants에 들어감"
    interviewTimetable(postingId: ID!): InterviewTimetable!
}

extend type Mutation {
    """
    면접 타임테이블 자동 생성. 서류 합격자를 각자 고른 면접 가능 시간에 먼저 낸 순으로 배정하고 면접관은 배정하지 않음.
    다시 부르면 기존 배정(면접관, 장소 포함)을 지우고 새로 만듦.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 면접 설정이 덜 채워졌으면 COMMON_400(reason: INTERVIEW_SETTING_REQUIRED),
    타임테이블이 확정된 뒤면 INTERVIEW_409(reason: TIMETABLE_CONFIRMED)
    """
    generateInterviewTimetable(postingId: ID!): InterviewTimetable!

    """
    면접 칸 하나를 추가하거나 수정. 확정 뒤에도 가능. 직접 배정은 지원자가 고른 시각, 포지션, 정원을 따지지 않음.
    새 칸의 track은 같은 시각에 이미 있는 열 다음 번호로 매김.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404, 그 공고의 칸이 아니면 INTERVIEW_404,
    COMMON_400 reason: NO_INTERVIEW, INTERVIEW_SETTING_REQUIRED, START_AT_REQUIRED(새 칸인데 startAt 없음),
    SLOT_NOT_OPEN(열려 있는 블록의 시작 시각이 아님), APPLICANT_NOT_ELIGIBLE(이 공고의 서류 합격자가 아님),
    INTERVIEWER_NOT_MEMBER(이 단체 소속 운영진이 아님).
    면접관이 시간이 겹치는 다른 칸에 있으면 INTERVIEW_409(reason: INTERVIEWER_TIME_OVERLAP)
    """
    updateInterview(postingId: ID!, input: InterviewInput!): InterviewTimetable!

    "면접 칸 삭제. 거기 있던 지원자는 미배정으로 돌아감. 그 공고 단체의 운영진만 (아니면 COMMON_403), 칸이 없으면 INTERVIEW_404"
    deleteInterview(id: ID!): InterviewTimetable!

    """
    면접 타임테이블 확정. 미배정 지원자가 남아 있어도 되고, 배정된 지원자에게 알림(POSTING_NOTICE)이 감.
    확정 뒤에는 면접 가능 시간 재선택과 자동 생성이 잠기고 칸 수정은 계속 가능.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404, 면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW),
    이미 확정했으면 INTERVIEW_409(reason: ALREADY_CONFIRMED), 배정된 지원자가 없으면 INTERVIEW_409(reason: NO_ASSIGNED_APPLICANT)
    """
    confirmInterviewTimetable(postingId: ID!): InterviewTimetable!

    """
    면접 가능 시간 재선택. 지원자 본인만 (아니면 COMMON_403), 지원서가 없으면 APPLICATION_404. 기존 값은 통째로 교체.
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 빈 목록이면 COMMON_400(reason: AVAILABLE_TIMES_REQUIRED),
    열려 있는 블록의 시작 시각이 아니면 COMMON_400(reason: AVAILABLE_TIME_NOT_OPEN),
    타임테이블이 확정된 뒤면 INTERVIEW_409(reason: TIMETABLE_CONFIRMED)
    """
    selectInterviewTimes(applicationId: ID!, availableTimes: [DateTime!]!): Application!
}
