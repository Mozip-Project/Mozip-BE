# 서류 평가, 면접 평가

extend type Query {
    "서류 평가 목록, 공고 단체 운영진만. 제출된 지원서만 나오고 결과 확정 뒤에도 조회된다. page는 1부터, 한 쪽에 10건. 공고 없으면 POSTING_404, 운영진 아니면 COMMON_403, page가 1 미만이거나 positionIds에 이 공고 포지션이 아닌 id가 있으면 COMMON_400"
    docEvaluationApplications(
        postingId: ID!
        tab: DocEvaluationTab = ALL
        "null이나 빈 배열이면 전체 포지션"
        positionIds: [ID!]
        "지원자 이름 부분 일치"
        keyword: String
        sort: ApplicationSort = SUBMITTED_DESC
        page: Int = 1
    ): DocEvaluationApplicationPage!

    "서류 평가 화면 위쪽 지원자 칩, 목록과 같은 조건으로 쪽 나눔 없이 전부. 에러는 docEvaluationApplications와 같다"
    docEvaluationApplicationChips(
        postingId: ID!
        tab: DocEvaluationTab = ALL
        positionIds: [ID!]
        keyword: String
        sort: ApplicationSort = SUBMITTED_DESC
    ): [DocEvaluationApplicationRow!]!

    "이 지원서에 내가 쓴 서류 평가, 아직 없으면 null. 지원서가 없거나 제출 전이면 EVALUATION_404, 운영진 아니면 COMMON_403"
    myDocEvaluation(applicationId: ID!): DocEvaluation
}

extend type Mutation {
    """
    서류 평가 저장. submit = false는 자동 저장(DRAFT)이라 비어 있어도 되고, true는 저장 버튼(SAVED)이라 의견과 점수를 검사한다.
    보낸 값으로 전체를 덮어쓴다. SAVED인 평가는 자동 저장해도 SAVED로 남는다.
    지원서가 없거나 제출 전이면 EVALUATION_404, 운영진 아니면 COMMON_403, 서류 결과 확정 뒤면 EVALUATION_423.
    입력이 틀리면 COMMON_400이고 reason은 OPINION_REQUIRED, SCORE_REQUIRED, INVALID_SCORE, MEMO_TOO_LONG, QUESTION_NOT_IN_POSTING
    """
    saveDocEvaluation(input: SaveDocEvaluationInput!, submit: Boolean!): SaveDocEvaluationPayload!
}

"서류 평가 목록 탭"
enum DocEvaluationTab {
    ALL
    "내 평가가 없거나 작성 중"
    NOT_EVALUATED
    "내 평가를 저장함"
    EVALUATED
}

"지원서 목록 정렬. 지원자 관리와 서류 평가 목록이 같이 쓴다. 취합 목록 정렬은 DocSummarySort"
enum ApplicationSort {
    SUBMITTED_DESC
    SUBMITTED_ASC
    NAME_ASC
    NAME_DESC
}

"서류 평가 1건의 저장 상태"
enum DocEvaluationStatus {
    "자동 저장만 됨"
    DRAFT
    "저장 버튼으로 저장함"
    SAVED
}

"한 지원서에 대한 내 서류 평가 상태. 목록 행에서만 쓴다"
enum MyDocEvaluationStatus {
    "평가를 시작하지 않음"
    NONE
    "자동 저장만 됨"
    DRAFT
    "저장 버튼으로 저장함"
    SAVED
}

type DocEvaluationApplicationPage {
    rows: [DocEvaluationApplicationRow!]!
    "탭, 포지션 필터, 검색어를 모두 적용한 건수"
    totalCount: Int!
    "포지션 필터와 검색어만 적용한 탭별 건수"
    tabCounts: DocEvaluationTabCounts!
    "검색어만 적용한 포지션별 건수, 공고의 포지션 순서대로. 포지션 없는 모집이면 빈 배열"
    positionCounts: [PositionCount!]!
    page: Int!
    "결과가 없으면 0"
    totalPages: Int!
}

type DocEvaluationApplicationRow {
    application: Application!
    myEvaluationStatus: MyDocEvaluationStatus!
}

type DocEvaluationTabCounts {
    all: Int!
    notEvaluated: Int!
    evaluated: Int!
}

"포지션별 지원서 수. 지원자 관리, 서류 평가, 취합 목록이 같이 쓴다"
type PositionCount {
    position: Position!
    count: Int!
}

input SaveDocEvaluationInput {
    applicationId: ID!
    opinion: Opinion
    "posting.docScorePerQuestion = true일 때만 쓴다. 아니면 보내도 저장하지 않는다"
    scores: [DocScoreInput!]
    "최대 300자"
    memo: String
}

input DocScoreInput {
    questionId: ID!
    "1~5점"
    score: Int!
}

type SaveDocEvaluationPayload {
    evaluation: DocEvaluation!
    "이 공고의 제출된 지원서 중 내 평가가 없거나 작성 중인 수, 탭과 필터와 무관"
    remainingCount: Int!
    "제출일 최신순으로 처음 나오는 미평가 지원서, 방금 저장한 지원서는 뺀다. 없으면 null"
    nextUnevaluatedApplicationId: ID
}

"평가 의견 (서류, 면접 공통)"
enum Opinion {
    PASS
    HOLD
    FAIL
}

"서류 평가 담당 운영진 (공고 포지션별 배정)"
type Reviewer {
    id: ID!
    posting: Posting!
    "포지션 없는 모집이면 null"
    position: Position
    member: Member!
}

"운영진별 서류 평가"
type DocEvaluation {
    id: ID!
    application: Application!
    "평가한 운영진"
    member: Member!
    status: DocEvaluationStatus!
    "자동 저장만 된 작성 중 상태에서는 null일 수 있음"
    opinion: Opinion
    "운영진만 보는 메모, 최대 300자"
    memo: String
    "문항별 점수, posting.docScorePerQuestion = true일 때만"
    scores: [DocScore!]!
    "처음 SAVED가 된 시각, null = 작성 중"
    submittedAt: DateTime
    updatedAt: DateTime!
}

type DocScore {
    question: Question!
    "1~5점"
    score: Int!
}

"운영진별 면접 평가"
type InterviewEvaluation {
    id: ID!
    application: Application!
    "평가한 운영진"
    member: Member!
    opinion: Opinion
    "종합 메모"
    memo: String
    "질문별 점수와 메모, 점수는 posting.interviewScorePerQuestion = true일 때만"
    scores: [InterviewScore!]!
    "null = 작성 중"
    submittedAt: DateTime
    updatedAt: DateTime!
}

"등록된 면접 질문이면 question, 면접 중 즉석 질문이면 customQuestion을 채움"
type InterviewScore {
    question: InterviewQuestion
    customQuestion: String
    score: Int
    memo: String
}

# 서류 평가 취합, 결과 확정 (#91)

"취합 화면 탭. ALL은 결과를 고르지 않은(PENDING) 지원자까지 포함"
enum DocResultTab {
    ALL
    PASS
    HOLD
    FAIL
}

"취합 목록 정렬"
enum DocSummarySort {
    "평균 점수 높은 순, 점수가 없는 지원자는 뒤로"
    SCORE_DESC
    "평균 점수 낮은 순, 점수가 없는 지원자는 뒤로"
    SCORE_ASC
    NAME_ASC
    NAME_DESC
    "합격 의견 많은 순"
    PASS_OPINION_DESC
}

"서류 평가 취합 목록 한 페이지 (10건)"
type DocEvaluationSummaryPage {
    rows: [DocEvaluationSummaryRow!]!
    "탭, 포지션, 검색어를 모두 적용한 건수"
    totalCount: Int!
    "포지션과 검색어만 적용한 탭별 건수"
    tabCounts: DocResultTabCounts!
    "검색어만 적용한 포지션별 건수, 포지션 없는 모집이면 빈 배열"
    positionCounts: [PositionCount!]!
    "1부터 시작"
    page: Int!
    totalPages: Int!
    "필터와 상관없이 공고 전체 기준"
    summary: DocResultSummary!
}

"취합 목록의 지원자 한 줄"
type DocEvaluationSummaryRow {
    application: Application!
    """
    운영진이 지정한 서류 결과. 지원자에게 가려지는 application.docResult와 달리 공고 단계와 상관없이 실제 값
    """
    docResult: DocResult!
    """
    공고 전체에서의 순위 (탭, 필터, 검색, 정렬과 무관). 운영진 전원이 평가를 저장한 지원자끼리만 매기고 아니면 null.
    평균 점수 높은 순, 같으면 합격 의견 많은 순, 그다음 먼저 제출한 순. 점수를 안 쓰는 공고는 합격 의견 수부터 비교
    """
    rank: Int
    """
    운영진별 문항 평균의 평균, 소수 둘째 자리까지 반올림. 저장된 평가만 계산.
    posting.docScorePerQuestion = false이거나 저장된 점수가 없으면 null
    """
    averageScore: Float
    opinionCounts: OpinionCounts!
    "공고 단체 운영진 전원이 평가를 저장했는지. true여야 결과를 지정할 수 있음"
    evaluationComplete: Boolean!
}

"저장된 평가의 의견별 운영진 수"
type OpinionCounts {
    pass: Int!
    hold: Int!
    fail: Int!
    "아직 저장하지 않은 운영진 수"
    notEvaluated: Int!
}

type DocResultTabCounts {
    all: Int!
    pass: Int!
    hold: Int!
    fail: Int!
}

"공고 전체 서류 결과 현황 (제출된 지원서 기준)"
type DocResultSummary {
    totalCount: Int!
    "운영진 전원이 평가를 저장한 지원자 수"
    evaluatedCount: Int!
    allEvaluated: Boolean!
    passCount: Int!
    holdCount: Int!
    failCount: Int!
    "결과를 아직 고르지 않은 지원자 수"
    pendingCount: Int!
    "지원자가 1명 이상이고 전원 평가가 끝났으며 보류와 미선택이 없고 아직 확정 전이면 true"
    canConfirm: Boolean!
    "서류 결과 확정 시각, null = 미확정"
    docResultConfirmedAt: DateTime
}

type SetDocResultPayload {
    application: Application!
    "방금 지정한 서류 결과 (application.docResult는 결과 발표 전까지 PENDING으로 가려짐)"
    docResult: DocResult!
    summary: DocResultSummary!
}

type ConfirmDocResultPayload {
    posting: Posting!
    summary: DocResultSummary!
}

extend type Query {
    """
    서류 평가 취합 목록. 공고 단체 운영진만 조회 가능하고 아니면 COMMON_403. 공고가 없으면 POSTING_404.
    page가 1보다 작거나 positionIds에 이 공고의 포지션이 아닌 id가 있으면 COMMON_400.
    sort를 비우면 점수를 쓰는 공고는 SCORE_DESC, 아니면 PASS_OPINION_DESC. keyword는 지원자 이름 검색
    """
    docEvaluationSummary(postingId: ID!, tab: DocResultTab = ALL, positionIds: [ID!], keyword: String, sort: DocSummarySort, page: Int = 1): DocEvaluationSummaryPage!
    """
    지원서 한 건에 운영진이 저장한 서류 평가 목록 (작성 중인 평가는 제외).
    공고 단체 운영진만 조회 가능하고 아니면 COMMON_403. 지원서가 없거나 제출 전이면 EVALUATION_404
    """
    docEvaluations(applicationId: ID!): [DocEvaluation!]!
}

extend type Mutation {
    """
    지원자 한 명의 서류 결과 지정. 같은 값을 다시 보내도 성공.
    운영진이 아니면 COMMON_403, 지원서가 없거나 제출 전이면 EVALUATION_404, result가 PENDING이면 COMMON_400,
    결과 확정 후면 EVALUATION_423, 운영진 전원이 평가를 저장하기 전이면 EVALUATION_409(reason: NOT_ALL_SAVED)
    """
    setDocResult(applicationId: ID!, result: DocResult!): SetDocResultPayload!
    """
    서류 결과 확정. 확정 후에는 평가와 결과를 바꿀 수 없음.
    운영진이 아니면 COMMON_403, 공고가 없으면 POSTING_404, 이미 확정했으면 EVALUATION_423.
    조건이 안 되면 EVALUATION_422이고 reason은 NO_APPLICANTS(제출된 지원서 없음), NOT_ALL_EVALUATED(평가가 덜 끝남),
    RESULT_NOT_SELECTED(결과를 안 고른 지원자가 남음), HOLD_REMAINING(보류가 남음) 순으로 먼저 걸리는 것
    """
    confirmDocResult(postingId: ID!): ConfirmDocResultPayload!
}
