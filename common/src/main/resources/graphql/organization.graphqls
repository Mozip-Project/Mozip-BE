# 단체, 팀, 운영진, 초대, 대표자 인수

enum OrganizationType {
    CLUB
    ACADEMIC
    STUDENT_COUNCIL
}

"학생회 세부 구분 (총학생회 / 단과대 / 학과)"
enum CouncilLevel {
    UNIVERSITY
    COLLEGE
    DEPARTMENT
}

"교내 / 연합 (연합이면 학교 없음)"
enum OrganizationScope {
    CAMPUS
    UNION
}

"관리자 심사 상태 (단체 등록, 학교 인증)"
enum ReviewStatus {
    PENDING
    APPROVED
    REJECTED
}

enum OrganizationField {
    ACADEMIC_STUDY
    IT_DEV
    DESIGN_MEDIA
    PERFORMANCE_MUSIC
    SPORTS
    CULTURE_HOBBY
    VOLUNTEER
    LANGUAGE_GLOBAL
    STARTUP_BUSINESS
    RELIGION
    ETC
}

enum OrganizationLinkType {
    INSTAGRAM
    WEBSITE
    YOUTUBE
    ETC
}

enum MemberRole {
    REPRESENTATIVE
    OPERATOR
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    CANCELED
}

enum TransferStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELED
}

type Organization {
    id: ID!
    name: String!
    "변경 요청 이름 (관리자 확인 후 반영)"
    pendingName: String
    type: OrganizationType!
    "학생회가 아니면 null"
    councilLevel: CouncilLevel
    scope: OrganizationScope!
    "연합이면 null"
    school: School
    logoUrl: String
    "한 줄 소개"
    tagline: String
    description: String
    "단체 메일"
    email: String
    noTeam: Boolean!
    proofLink: String
    proofFileUrl: String
    reviewStatus: ReviewStatus!
    rejectReason: String
    trialEndsAt: DateTime
    "유료 기능 사용 가능 기한"
    packageEndsAt: DateTime
    "UP하기 잔여권"
    upCredits: Int!
    keywords: [String!]!
    fields: [OrganizationField!]!
    links: [OrganizationLink!]!
    teams: [Team!]!
    members: [Member!]!
    createdAt: DateTime!
}

type OrganizationLink {
    id: ID!
    type: OrganizationLinkType!
    url: String!
}

type Team {
    id: ID!
    organization: Organization!
    name: String!
    sortOrder: Int!
}

"단체 운영진 (회원의 단체 소속)"
type Member {
    id: ID!
    organization: Organization!
    user: User!
    "한 팀에만 소속, 팀 없는 단체면 null"
    team: Team
    role: MemberRole!
    createdAt: DateTime!
}

type Invitation {
    id: ID!
    organization: Organization!
    inviter: User!
    "가입자면 바로 채움, 미가입이면 가입 시 contact로 찾아 채움"
    invitee: User
    "휴대폰 번호 또는 이메일"
    inviteeContact: String!
    status: InvitationStatus!
    "발송 후 7일"
    expiresAt: DateTime!
    createdAt: DateTime!
}

"초대 링크 (mozip.kr/invite/{token})"
type InviteLink {
    id: ID!
    organization: Organization!
    token: String!
    "생성 후 7일"
    expiresAt: DateTime!
}

type RepresentativeTransfer {
    id: ID!
    organization: Organization!
    requester: User!
    message: String
    status: TransferStatus!
    createdAt: DateTime!
}

input CreateOrganizationInput {
    name: String!
    type: OrganizationType!
    "학생회면 필수, 그 외 단체는 넣으면 COMMON_400 (reason COUNCIL_LEVEL_NOT_ALLOWED)"
    councilLevel: CouncilLevel
    scope: OrganizationScope!
    "교내면 필수, 연합이면 넣으면 COMMON_400 (reason SCHOOL_NOT_ALLOWED)"
    schoolId: ID
    noTeam: Boolean! = false
    proofLink: String
    proofFileUrl: String
}

"단체 프로필 수정 입력. 단체명은 바꿀 수 없음 (관리자 문의). 키워드/분야/링크는 보낸 목록으로 전체 교체"
input UpdateOrganizationInput {
    "업로드 URL 발급으로 받은 fileUrl, null이면 기본 이미지로 초기화"
    logoUrl: String
    "한 줄 소개, 최대 40자"
    tagline: String!
    description: String
    "단체 메일"
    email: String
    "학생회가 아니면 1개 이상 (reason FIELDS_REQUIRED), 학생회는 빈 목록 (reason FIELDS_NOT_ALLOWED)"
    fields: [OrganizationField!]!
    "검색 키워드 1~10개, 중복은 하나로 합침"
    keywords: [String!]!
    "SNS/웹사이트 주소 1~10개. 스킴이 없으면 https://를 붙이고 type은 호스트로 추정. 호스트가 없으면 reason LINK_URL_INVALID"
    links: [String!]!
}

extend type Query {
    "내가 운영진으로 속한 단체 (운영진 홈의 단체 전환 메뉴)"
    myOrganizations: [Organization!]!
    "단체 상세, 로그인 없이 조회 가능. 없으면 ORG_404"
    organization(id: ID!): Organization! @public
    "키워드 자동완성, 전 단체 키워드 중 접두 일치 상위 10개 (많이 쓰인 순). 빈 접두어면 빈 목록"
    keywordSuggestions(prefix: String!): [String!]!
}

extend type Mutation {
    "단체를 만들고 호출자를 대표자로 등록, 심사 상태는 PENDING"
    createOrganization(input: CreateOrganizationInput!): Organization!
    "단체 프로필 수정, 그 단체의 운영진만 가능 (아니면 COMMON_403). 없으면 ORG_404"
    updateOrganization(id: ID!, input: UpdateOrganizationInput!): Organization!
}
