# 면접 타임테이블

"타임테이블의 면접 한 칸"
type Interview {
    id: ID!
    posting: Posting!
    startAt: DateTime!
    endAt: DateTime!
    "같은 시간대에 동시에 진행하는 면접실 열 (면접실 1, 면접실 2), 1부터"
    track: Int!
    "면접 장소, 운영진이 직접 입력 (후보 = InterviewTimetable.recentLocations)"
    location: String
    "운영진이 직접 추가한 면접관, 자동 배정은 없어 처음에는 비어 있음"
    interviewers: [Member!]!
    "배정된 지원자, 2명 이상이면 그룹 면접. 자동 생성은 같은 포지션끼리만 묶고 직접 배정은 포지션 제한 없음"
    applicants: [Application!]!
}

"타임테이블 격자의 블록 한 칸. 면접 설정과 운영진이 연 시간대로 매번 계산하고 저장하지 않음"
type InterviewSlot {
    startAt: DateTime!
    "면접이 끝나는 시각, 쉬는 시간은 그 뒤에 붙음"
    endAt: DateTime!
    "운영진이 끈 블록이면 true, 자동 생성은 여기에 배정하지 않음"
    closed: Boolean!
}

"운영진이 보는 면접 타임테이블"
type InterviewTimetable {
    posting: Posting!
    "확정 시각, 확정 전이면 null. 다시 확정하면 새 시각으로 바뀜"
    confirmedAt: DateTime
    "확정 후 수정 모드면 true. 서버가 들고 있어서 새로 고쳐도 유지됨"
    editing: Boolean!
    "면접실 열 개수. 공고의 동시 진행 수에 운영진이 늘린 열을 더한 값, 모든 날짜에 같이 적용"
    trackCount: Int!
    "빈 칸까지 포함한 전체 블록, 시간순. 면접 설정이 덜 채워졌으면 빈 목록"
    slots: [InterviewSlot!]!
    "지원자가 배정된 면접 칸, 시작 시각과 track 순. 여기 없는 (블록, 열) 자리는 빈 칸"
    interviews: [Interview!]!
    "서류 합격인데 어느 칸에도 없는 지원자, 먼저 낸 순"
    unassignedApplicants: [Application!]!
    "이 모집에서 쓴 장소, 최근에 쓴 순"
    recentLocations: [String!]!
}

"면접관 추가 목록의 한 줄"
type InterviewerCandidate {
    member: Member!
    "그 시각에 들어가 있는 다른 면접(다른 공고 포함). 있으면 면접관으로 고를 수 없음"
    busyInterview: Interview
}

"면접 칸 하나에 넣을 값. null인 필드는 그대로 둠"
input InterviewInput {
    "칸의 id. 없으면 startAt과 track이 가리키는 칸 (이미 있으면 그 칸, 없으면 새로 만듦)"
    id: ID
    "id가 없을 때 칸의 시작 시각, 열려 있는 블록의 시작 시각이어야 함"
    startAt: DateTime
    "id가 없을 때 면접실 열 번호, 1부터 trackCount까지. 안 보내면 그 시각에 비어 있는 가장 앞 열"
    track: Int
    "면접 장소, 100자까지. 빈 문자열이면 비움"
    location: String
    "이 칸의 지원자 전체. 다른 칸에 있던 지원자는 옮겨 오고 목록에서 빠진 지원자는 미배정이 됨. 2명 이상이면 그룹 면접"
    applicationIds: [ID!]
    "이 칸의 면접관(Member id) 전체"
    interviewerMemberIds: [ID!]
}

extend type Query {
    "면접 타임테이블 조회. 그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404. 생성 전이면 interviews는 비고 서류 합격자가 전부 unassignedApplicants에 들어감"
    interviewTimetable(postingId: ID!): InterviewTimetable!

    """
    면접관 추가 목록. 그 공고 단체의 활동 중인 운영진 전체, 대표 먼저.
    startAt에 시작하는 면접과 시간이 겹치는 다른 면접에 들어가 있으면 busyInterview가 채워짐.
    interviewId는 지금 면접관을 고르는 칸, 그 칸에 이미 있는 면접관은 바쁜 것으로 치지 않음.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    COMMON_400 reason: NO_INTERVIEW, INTERVIEW_SETTING_REQUIRED
    """
    interviewerCandidates(postingId: ID!, startAt: DateTime!, interviewId: ID): [InterviewerCandidate!]!
}

extend type Mutation {
    """
    면접 타임테이블 자동 생성. 서류 합격자를 각자 고른 면접 가능 시간에 먼저 낸 순으로 배정하고 면접관은 배정하지 않음.
    다시 부르면 기존 배정(면접관, 장소 포함)을 지우고 새로 만듦.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 면접 설정이 덜 채워졌으면 COMMON_400(reason: INTERVIEW_SETTING_REQUIRED),
    타임테이블이 확정된 뒤면 INTERVIEW_409(reason: TIMETABLE_CONFIRMED)
    """
    generateInterviewTimetable(postingId: ID!): InterviewTimetable!

    """
    면접 칸 하나에 지원자, 면접관, 장소를 넣음. 직접 배정은 지원자가 고른 시각, 포지션, 정원을 따지지 않음.
    지원자를 옮기거나 빼서 지원자가 없어진 칸은 면접관과 함께 지워짐.
    확정 뒤에는 장소만 바로 바꿀 수 있고 나머지는 수정 모드에서만 (아니면 INTERVIEW_409 reason: EDIT_MODE_REQUIRED).
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404, 그 공고의 칸이 아니면 INTERVIEW_404,
    COMMON_400 reason: NO_INTERVIEW, INTERVIEW_SETTING_REQUIRED, START_AT_REQUIRED(id도 startAt도 없음),
    SLOT_NOT_OPEN(열려 있는 블록의 시작 시각이 아님), TRACK_OUT_OF_RANGE(열 번호가 범위 밖이거나 빈 열이 없음),
    APPLICANTS_REQUIRED(빈 칸에 처음 넣는데 지원자가 없음), APPLICANT_NOT_ELIGIBLE(이 공고의 서류 합격자가 아님),
    INTERVIEWER_NOT_MEMBER(이 단체 소속 운영진이 아님).
    면접관이 시간이 겹치는 다른 칸에 있으면 INTERVIEW_409(reason: INTERVIEWER_TIME_OVERLAP)
    """
    updateInterview(postingId: ID!, input: InterviewInput!): InterviewTimetable!

    """
    그 날짜, 그 면접실 열의 모든 칸 장소를 한 번에 바꿈. 따로 정한 장소도 바뀜. 빈 문자열이나 null이면 비움.
    확정 뒤 보기 모드에서도 가능. 그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW)
    """
    updateInterviewLocations(postingId: ID!, date: Date!, track: Int!, location: String): InterviewTimetable!

    """
    면접실 열을 하나 늘림. 늘린 열은 다시 생성할 때도 쓰임.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    COMMON_400 reason: NO_INTERVIEW, INTERVIEW_SETTING_REQUIRED.
    확정 뒤에는 수정 모드에서만 (아니면 INTERVIEW_409 reason: EDIT_MODE_REQUIRED)
    """
    addInterviewTrack(postingId: ID!): InterviewTimetable!

    """
    확정된 타임테이블의 수정 모드로 들어감. 이때의 상태를 서버가 떠 두고 cancelInterviewTimetableEdit로 되돌림.
    이미 수정 모드면 그대로 돌려줌. 그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 확정 전이면 INTERVIEW_409(reason: NOT_CONFIRMED)
    """
    startInterviewTimetableEdit(postingId: ID!): InterviewTimetable!

    """
    수정 모드에서 바꾼 배정, 면접관, 장소, 면접실 열을 버리고 확정했던 상태로 되돌림. 칸의 id는 새로 매겨짐.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404,
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 수정 모드가 아니면 INTERVIEW_409(reason: NOT_EDITING)
    """
    cancelInterviewTimetableEdit(postingId: ID!): InterviewTimetable!

    """
    면접 타임테이블 확정. 수정 모드에서 부르면 수정한 내용으로 다시 확정하고 수정 모드를 끝냄.
    지원자에게 알림은 보내지 않음 (안내는 장소를 채운 뒤 결과 안내에서).
    확정 뒤에는 면접 가능 시간 재선택과 자동 생성이 잠김.
    그 공고 단체의 운영진만 (아니면 COMMON_403), 공고가 없으면 POSTING_404, 면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW),
    INTERVIEW_409 reason: UNASSIGNED_APPLICANT_REMAINS(미배정 지원자가 남음), NO_ASSIGNED_APPLICANT(배정된 지원자가 없음),
    ALREADY_CONFIRMED(이미 확정했고 수정 모드가 아님)
    """
    confirmInterviewTimetable(postingId: ID!): InterviewTimetable!

    """
    면접 가능 시간 재선택. 지원자 본인만 (아니면 COMMON_403), 지원서가 없으면 APPLICATION_404. 기존 값은 통째로 교체.
    면접 없는 공고면 COMMON_400(reason: NO_INTERVIEW), 빈 목록이면 COMMON_400(reason: AVAILABLE_TIMES_REQUIRED),
    열려 있는 블록의 시작 시각이 아니면 COMMON_400(reason: AVAILABLE_TIME_NOT_OPEN),
    타임테이블이 확정된 뒤면 INTERVIEW_409(reason: TIMETABLE_CONFIRMED)
    """
    selectInterviewTimes(applicationId: ID!, availableTimes: [DateTime!]!): Application!
}
