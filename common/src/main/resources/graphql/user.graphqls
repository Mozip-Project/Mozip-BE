# 회원, 학교 인증, 활동 경험, 알림

"Spring Security 권한"
enum Authority {
    USER
    ADMIN
}

enum UserStatus {
    ACTIVE
    "로그인 5회 실패 (휴대폰 인증으로 해제)"
    LOCKED
    WITHDRAWN
}

"로그인 후 이동할 홈"
enum Role {
    APPLICANT
    OPERATOR
}

"학교 인증 메일을 worker가 실제로 보냈는지. requestSchoolEmailVerification의 true는 접수됐다는 뜻일 뿐이라 이 값으로 발송 결과를 확인함"
enum SchoolEmailVerificationStatus {
    PENDING
    SENT
    FAILED
}

"알림 탭(지원자/운영진), 알림 설정 토글, 출처 라벨, 이동 화면을 type으로 정함"
enum NotificationType {
    POSTING_NOTICE
    DOC_RESULT
    FINAL_RESULT
    INTERVIEW_RESELECT
    SCRAP_OPEN
    INVITATION
    TRANSFER_REQUEST
    TRANSFER_APPROVED
    TRANSFER_REJECTED
    EVALUATION_REQUEST
    EVALUATION_DEADLINE
}

type School {
    id: ID!
    name: String!
    "학교 메일 인증 도메인 (예: skku.edu)"
    emailDomain: String
}

type User {
    id: ID!
    "로그인 ID (숫자만, 예: 01012345678)"
    phone: String!
    name: String!
    authority: Authority!
    status: UserStatus!
    lastRole: Role!
    "학교 인증 승인 시 채움, null = 미인증 (공고 열람만 가능)"
    school: School
    profileImageUrl: String
    department: String
    grade: Int
    contactEmail: String
    marketingAgreed: Boolean!
    termsAgreedAt: DateTime!
    "지원 결과, 면접 일정 알림"
    notifyResult: Boolean!
    "스크랩 공고 지원 시작 알림"
    notifyScrap: Boolean!
    "대표자 인수 요청, 평가 마감 알림"
    notifyOperator: Boolean!
    experiences: [Experience!]!
    createdAt: DateTime!
}

"활동 경험"
type Experience {
    id: ID!
    "활동명"
    title: String!
    role: String
    achievement: String
    startedOn: Date
    endedOn: Date
}

type Notification {
    id: ID!
    type: NotificationType!
    "알림에 표시할 단체 (지원자 알림도 지원한 단체를 표시)"
    organization: Organization
    "결과 안내, 공지 알림이 가리키는 메시지 (결과 팝업, 공지 전문 보기), 그 외 알림은 null"
    message: Message
    title: String!
    linkUrl: String
    isRead: Boolean!
    createdAt: DateTime!
}

input UpdateNotificationSettingsInput {
    notifyResult: Boolean!
    notifyScrap: Boolean!
    notifyOperator: Boolean!
}

"로그인한 회원이 보는 내 정보. User와 별개 타입으로 두어 본인에게만 필요한 필드(소속 단체 목록, 알림 요약)를 담음"
type Me {
    id: ID!
    "로그인 ID (숫자만, 예: 01012345678)"
    phone: String!
    name: String!
    authority: Authority!
    status: UserStatus!
    lastRole: Role!
    "학교 인증 승인 시 채움, null = 미인증 (공고 열람만 가능)"
    school: School
    marketingAgreed: Boolean!
    termsAgreedAt: DateTime!
    "운영진으로 소속된 단체 목록 (단체 전환 선택 UI에 사용)"
    organizations: [Organization!]!
    "소속 단체 목록 (드롭다운 항목), organization / role / team"
    memberships: [Member!]!
    notificationSettings: NotificationSettings!
    "알림 기능 구현 전까지 0 반환"
    unreadNotificationCount: Int!
    createdAt: DateTime!
}

type NotificationSettings {
    "지원 결과, 면접 일정 알림"
    notifyResult: Boolean!
    "스크랩 공고 지원 시작 알림"
    notifyScrap: Boolean!
    "대표자 인수 요청, 평가 마감 알림"
    notifyOperator: Boolean!
}

extend type Query {
    "내 알림 목록. role로 지원자/운영진 탭을 고르고 최신순으로 반환"
    notifications(role: Role!, page: Int = 0, size: Int = 20): [Notification!]!
    "로그인한 회원 정보 (지원자/운영진 화면 분기에 사용)"
    me: Me!
    "학교 이름 검색 (단체 만들기, 학교 인증 화면 자동완성). 상위 20개만, keyword가 비면 빈 배열"
    schools(keyword: String): [School!]! @public
    "requestSchoolEmailVerification 이후 실제 발송 상태를 폴링으로 확인. 요청한 적 없거나 5분 지나면 null"
    schoolEmailVerificationStatus(email: String!): SchoolEmailVerificationStatus @public
}

extend type Mutation {
    "요청한 id 중 내 알림이 아닌 게 있으면 NOTIFICATION_403"
    markNotificationsRead(ids: [ID!]!): Boolean!
    "알림 수신 설정 변경"
    updateNotificationSettings(input: UpdateNotificationSettingsInput!): NotificationSettings!
    """
    로그인 없이도 호출 가능. 메일 도메인으로 학교를 찾아 인증번호를 메일로 보냄(5분 유효). 못 찾으면 SCHOOL_404.
    true는 발송 작업이 접수됐다는 뜻이고 실제로 메일이 갔는지는 보장하지 않음. schoolEmailVerificationStatus로 확인.
    로그인한 상태로 호출했고 이미 학교 인증된 회원이면 SCHOOL_409(reason: ALREADY_VERIFIED).
    이 메일이 이미 다른(또는 같은) 회원의 인증에 쓰였으면 SCHOOL_409(reason: EMAIL_ALREADY_VERIFIED).
    짧은 시간에 반복 요청하면 SCHOOL_429
    """
    requestSchoolEmailVerification(email: String!): Boolean! @public
    """
    인증번호를 확인하고 맞으면 바로 회원의 학교를 채움(APPROVED).
    불일치/만료는 SCHOOL_400(reason: CODE_MISMATCH 또는 CODE_EXPIRED).
    이미 학교 인증된 회원이면 SCHOOL_409(reason: ALREADY_VERIFIED)
    """
    verifySchoolEmail(email: String!, code: String!): Me!
}
